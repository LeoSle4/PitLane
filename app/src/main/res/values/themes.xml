<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Tema base de la aplicacion: colores de marca, fuente y formas -->
    <style name="Base.Theme.PitLane" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primario</item>
        <item name="colorOnPrimary">@color/sobre_primario</item>
        <item name="colorPrimaryContainer">@color/contenedor_primario</item>
        <item name="colorOnPrimaryContainer">@color/sobre_contenedor_primario</item>
        <item name="colorSecondary">@color/acento</item>
        <item name="colorSurface">@color/superficie</item>
        <item name="colorOnSurface">@color/texto_primario</item>
        <item name="colorSurfaceVariant">@color/superficie_variante</item>
        <item name="colorOnSurfaceVariant">@color/texto_secundario</item>
        <item name="colorOutline">@color/contorno</item>
        <item name="colorError">@color/peligro</item>
        <item name="android:colorBackground">@color/fondo</item>
        <item name="android:windowBackground">@color/fondo</item>
        <item name="android:textColorPrimary">@color/texto_primario</item>
        <item name="android:textColorSecondary">@color/texto_secundario</item>
        <item name="android:fontFamily">@font/fuente_jakarta</item>
        <item name="fontFamily">@font/fuente_jakarta</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
        <item name="bottomSheetDialogTheme">@style/Tema.HojaModal</item>
        <item name="android:windowAnimationStyle">@style/Animacion.Ventana</item>
    </style>

    <style name="Theme.PitLane" parent="Base.Theme.PitLane" />

    <!-- Tema de la hoja modal inferior: superficie sólida con esquinas superiores redondeadas, sin la capa de elevación en modo oscuro -->
    <style name="Tema.HojaModal" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Estilo.HojaModal</item>
        <item name="elevationOverlayEnabled">false</item>
    </style>

    <style name="Estilo.HojaModal" parent="Widget.Material3.BottomSheet">
        <item name="backgroundTint">@color/superficie</item>
        <item name="shapeAppearanceOverlay">@style/Forma.Hoja</item>
    </style>

    <style name="Forma.Hoja" parent="">
        <item name="cornerSizeTopLeft">@dimen/radio_hoja</item>
        <item name="cornerSizeTopRight">@dimen/radio_hoja</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <!-- Tema de los dialogos de confirmacion centrados -->
    <style name="Tema.Dialogo" parent="Theme.Material3.DayNight.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.5</item>
        <item name="android:windowMinWidthMajor">0dp</item>
        <item name="android:windowMinWidthMinor">0dp</item>
    </style>

    <style name="Animacion.Ventana" parent="@android:style/Animation.Activity" />

    <!-- Tema del visor de fotos a pantalla completa -->
    <style name="Tema.Visor" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
