<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Estilos de texto: Display, Titulo, Subtitulo, Cuerpo, Etiqueta y Pie -->
    <style name="Texto" parent="">
        <item name="android:fontFamily">@font/fuente_jakarta</item>
        <item name="android:textColor">@color/texto_primario</item>
        <item name="android:includeFontPadding">false</item>
    </style>
    <style name="Texto.Display">
        <item name="android:fontFamily">@font/fuente_lora</item>
        <item name="android:textSize">26sp</item>
        <item name="android:textFontWeight">600</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>
    <style name="Texto.Titulo">
        <item name="android:fontFamily">@font/fuente_lora</item>
        <item name="android:textSize">19sp</item>
        <item name="android:textFontWeight">600</item>
    </style>
    <style name="Texto.Subtitulo">
        <item name="android:textSize">16sp</item>
        <item name="android:textFontWeight">600</item>
    </style>
    <style name="Texto.Cuerpo">
        <item name="android:textSize">14sp</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>
    <style name="Texto.Secundario" parent="Texto.Cuerpo">
        <item name="android:textColor">@color/texto_secundario</item>
    </style>
    <style name="Texto.Etiqueta">
        <item name="android:textSize">12sp</item>
        <item name="android:textFontWeight">500</item>
    </style>
    <style name="Texto.Pie">
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/texto_secundario</item>
    </style>
    <style name="Texto.Numero" parent="Texto.Subtitulo">
        <item name="android:fontFeatureSettings">"tnum"</item>
    </style>

    <!-- Botones: primario, secundario, texto y peligro -->
    <style name="Boton.Primario" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/alto_boton</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textFontWeight">600</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">@color/sel_texto_boton_primario</item>
        <item name="backgroundTint">@color/sel_fondo_boton_primario</item>
        <item name="cornerRadius">@dimen/radio_boton</item>
    </style>
    <style name="Boton.Peligro" parent="Boton.Primario">
        <item name="android:textColor">@color/sel_texto_boton_primario</item>
        <item name="backgroundTint">@color/sel_fondo_boton_peligro</item>
    </style>
    <style name="Boton.Secundario" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/alto_boton</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textFontWeight">600</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">@color/primario</item>
        <item name="strokeColor">@color/contorno</item>
        <item name="strokeWidth">1dp</item>
        <item name="cornerRadius">@dimen/radio_boton</item>
    </style>
    <style name="Boton.Fila" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">44dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:gravity">start|center_vertical</item>
        <item name="android:textAlignment">viewStart</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textFontWeight">500</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:paddingStart">0dp</item>
        <item name="android:textColor">@color/texto_primario</item>
        <item name="iconGravity">start</item>
        <item name="iconPadding">12dp</item>
        <item name="iconSize">18dp</item>
        <item name="iconTint">@color/texto_secundario</item>
        <item name="cornerRadius">@dimen/radio_boton</item>
    </style>
    <style name="Boton.Texto" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">@dimen/area_tactil</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textFontWeight">600</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">@color/primario</item>
        <item name="cornerRadius">@dimen/radio_boton</item>
    </style>
    <style name="Boton.Icono" parent="Widget.Material3.Button.IconButton">
        <item name="android:minWidth">@dimen/area_tactil</item>
        <item name="android:minHeight">@dimen/area_tactil</item>
        <item name="iconTint">@color/texto_primario</item>
    </style>

    <!-- Campos de formulario: etiqueta, EditText, error y combo -->
    <style name="Campo.Etiqueta" parent="Texto.Etiqueta">
        <item name="android:layout_marginBottom">6dp</item>
        <item name="android:textColor">@color/texto_primario</item>
    </style>
    <style name="Campo.Texto" parent="Widget.AppCompat.EditText">
        <item name="android:background">@drawable/fondo_campo</item>
        <item name="android:minHeight">@dimen/alto_boton</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">@font/fuente_jakarta</item>
        <item name="android:textColor">@color/texto_primario</item>
        <item name="android:textColorHint">@color/texto_secundario</item>
        <item name="android:drawablePadding">8dp</item>
        <item name="android:imeOptions">actionNext</item>
    </style>
    <style name="Campo.Pildora" parent="Campo.Texto">
        <item name="android:background">@drawable/fondo_campo_pildora</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:drawablePadding">12dp</item>
        <item name="android:drawableTint">@color/texto_secundario</item>
    </style>
    <style name="Campo.Error" parent="Texto.Pie">
        <item name="android:textColor">@color/peligro</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:visibility">gone</item>
    </style>
    <style name="Campo.Combo" parent="Widget.AppCompat.Spinner">
        <item name="android:background">@drawable/fondo_combo</item>
        <item name="android:minHeight">@dimen/alto_boton</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">40dp</item>
        <item name="android:popupBackground">@drawable/fondo_menu</item>
    </style>
    <style name="Campo.Casilla" parent="Widget.Material3.CompoundButton.CheckBox">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/texto_primario</item>
        <item name="android:minHeight">@dimen/area_tactil</item>
        <item name="android:fontFamily">@font/fuente_jakarta</item>
    </style>
    <style name="Campo.Opcion" parent="Widget.AppCompat.CompoundButton.RadioButton">
        <item name="android:button">@null</item>
        <item name="android:background">@drawable/fondo_opcion</item>
        <item name="android:textColor">@color/sel_texto_opcion</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">@font/fuente_jakarta</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:layout_marginBottom">8dp</item>
    </style>

    <!-- Tarjeta de contenido y lista -->
    <style name="Tarjeta" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/superficie</item>
        <item name="cardCornerRadius">@dimen/radio_tarjeta</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/contorno</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardUseCompatPadding">false</item>
    </style>
    <!-- Lista con separación transparente entre tarjetas: un ListView ignora los márgenes de la raíz de cada fila -->
    <style name="Lista.Espaciada">
        <item name="android:divider">@android:color/transparent</item>
        <item name="android:dividerHeight">12dp</item>
    </style>
    <style name="Lista" parent="">
        <item name="android:divider">@null</item>
        <item name="android:dividerHeight">0dp</item>
        <item name="android:listSelector">@android:color/transparent</item>
        <item name="android:clipToPadding">false</item>
        <item name="android:scrollbars">none</item>
        <item name="android:overScrollMode">never</item>
    </style>

    <!-- Chip de estado: la forma y los colores se aplican desde codigo -->
    <style name="Chip" parent="Texto.Etiqueta">
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingTop">5dp</item>
        <item name="android:paddingBottom">5dp</item>
        <item name="android:drawablePadding">6dp</item>
        <item name="android:gravity">center_vertical</item>
    </style>

    <style name="Animacion.MenuEmergente" parent="">
        <item name="android:windowEnterAnimation">@anim/menu_entrar</item>
        <item name="android:windowExitAnimation">@anim/menu_salir</item>
    </style>
</resources>
