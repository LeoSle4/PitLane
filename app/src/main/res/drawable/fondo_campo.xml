<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/superficie_variante" />
            <corners android:radius="@dimen/radio_campo" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/fondo" />
            <stroke android:width="2dp" android:color="@color/primario" />
            <corners android:radius="@dimen/radio_campo" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/superficie_variante" />
            <stroke android:width="1dp" android:color="@color/contorno" />
            <corners android:radius="@dimen/radio_campo" />
        </shape>
    </item>
</selector>
