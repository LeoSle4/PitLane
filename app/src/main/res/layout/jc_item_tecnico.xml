<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mcvTecnico"
    style="@style/Tarjeta"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:id="@+id/llFilaTecnico"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="18dp"
        android:paddingEnd="4dp"
        android:paddingBottom="18dp">

        <FrameLayout
            android:id="@+id/flAvatarTecnico"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/jc_fondo_avatar">

            <TextView
                android:id="@+id/txtInicialesTecnico"
                style="@style/Texto.Subtitulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:textColor="@color/sobre_contenedor_primario" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtNombreTecnico"
                style="@style/Texto.Subtitulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/txtTelefonoTecnico"
                    style="@style/Texto.Secundario"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:drawablePadding="6dp"
                    android:gravity="center_vertical"
                    android:maxLines="1"
                    app:drawableStartCompat="@drawable/ic_phone_pequeno"
                    app:drawableTint="@color/texto_secundario" />

                <TextView
                    android:id="@+id/txtDniTecnico"
                    style="@style/Texto.Secundario"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:drawablePadding="6dp"
                    android:gravity="center_vertical"
                    android:maxLines="1"
                    app:drawableStartCompat="@drawable/ic_identification_card_pequeno"
                    app:drawableTint="@color/texto_secundario" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/txtChipEstadoTecnico"
                    style="@style/Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/txtOrdenesEnCurso"
                    style="@style/Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:layout_marginStart="8dp" />
            </LinearLayout>
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnMenuTecnico"
            android:layout_width="@dimen/area_tactil"
            android:layout_height="@dimen/area_tactil"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/jc_cd_opciones_tecnico"
            android:focusable="false"
            android:src="@drawable/ic_dots_three_vertical"
            app:tint="@color/texto_secundario" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
