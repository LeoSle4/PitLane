<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:padding="24dp">

    <LinearLayout
        android:id="@+id/llTarjetaDialogo"
        android:layout_width="@dimen/ancho_dialogo"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/fondo_dialogo"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <FrameLayout
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/fondo_circulo_suave">

            <ImageView
                android:id="@+id/imgIconoDialogo"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_warning_circle"
                xmlns:app="http://schemas.android.com/apk/res-auto"
                app:tint="@color/sobre_contenedor_primario" />
        </FrameLayout>

        <TextView
            android:id="@+id/txtTituloDialogo"
            style="@style/Texto.Titulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center" />

        <TextView
            android:id="@+id/txtMensajeDialogo"
            style="@style/Texto.Secundario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center" />

        <LinearLayout
            android:id="@+id/llCampoDialogo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/txtEtiquetaCampoDialogo"
                style="@style/Campo.Etiqueta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <EditText
                android:id="@+id/etCampoDialogo"
                style="@style/Campo.Texto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:importantForAutofill="no"
                android:inputType="text" />

            <TextView
                android:id="@+id/txtErrorCampoDialogo"
                style="@style/Campo.Error"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="end"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnCancelarDialogo"
                style="@style/Boton.Texto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cancelar" />

            <Button
                android:id="@+id/btnAccionDialogo"
                style="@style/Boton.Primario"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:minWidth="112dp"
                android:minHeight="48dp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
