<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/vpFotos"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ImageButton
        android:id="@+id/btnCerrarVisor"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|start"
        android:layout_margin="16dp"
        android:background="@drawable/fondo_vidrio_circulo"
        android:contentDescription="Cerrar visor"
        android:padding="13dp"
        android:src="@drawable/ic_x"
        app:tint="@color/texto_primario" />

    <ImageButton
        android:id="@+id/btnEliminarFotoVisor"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|end"
        android:layout_margin="16dp"
        android:background="@drawable/fondo_vidrio_circulo"
        android:contentDescription="Eliminar foto"
        android:padding="13dp"
        android:src="@drawable/ic_trash"
        android:visibility="gone"
        app:tint="@color/peligro" />

    <TextView
        android:id="@+id/txtContadorVisor"
        style="@style/Texto.Etiqueta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="32dp"
        android:background="@drawable/fondo_vidrio"
        android:paddingStart="14dp"
        android:paddingTop="6dp"
        android:paddingEnd="14dp"
        android:paddingBottom="6dp" />
</FrameLayout>
