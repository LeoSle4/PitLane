<?xml version="1.0" encoding="utf-8"?>
<!-- Fila de la lista de solicitudes: barra del color del estado, placa, fecha, resumen, chip y menú para las pendientes. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mcvSolicitud"
    style="@style/Tarjeta"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <View
            android:id="@+id/viewBarraEstado"
            android:layout_width="6dp"
            android:layout_height="match_parent"
            android:background="@drawable/cli_barra_estado" />

        <ImageView
            android:id="@+id/imgMarcaSolicitud"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="12dp"
            android:background="@drawable/fondo_logo_marca"
            android:contentDescription="@null"
            android:padding="6dp"
                android:scaleType="fitCenter" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="12dp"
            android:paddingEnd="4dp"
            android:paddingBottom="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/txtPlacaSolicitud"
                    style="@style/Texto.Titulo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:maxLines="1" />

                <ImageButton
                    android:id="@+id/btnMenuSolicitud"
                    android:layout_width="@dimen/area_tactil"
                    android:layout_height="@dimen/area_tactil"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/cli_mas_opciones"
                    android:focusable="false"
                    android:src="@drawable/ic_dots_three_vertical"
                    android:visibility="gone"
                    app:tint="@color/texto_secundario" />
            </LinearLayout>

            <TextView
                android:id="@+id/txtFechaSolicitud"
                style="@style/Texto.Etiqueta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:textColor="@color/texto_secundario" />

            <TextView
                android:id="@+id/txtResumenSolicitud"
                style="@style/Texto.Cuerpo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginEnd="12dp"
                android:ellipsize="end"
                android:maxLines="2" />

            <TextView
                android:id="@+id/txtEstadoSolicitud"
                style="@style/Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
