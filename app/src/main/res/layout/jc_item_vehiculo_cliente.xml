<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mcvVehiculoCliente"
    style="@style/Tarjeta"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp">

    <LinearLayout
        android:id="@+id/llTarjetaVehiculo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/llCabeceraVehiculo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="14dp"
            android:paddingEnd="4dp"
            android:paddingBottom="8dp">

            <FrameLayout
                android:id="@+id/flIconoVehiculo"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@android:color/transparent">

                <ImageView
                    android:id="@+id/imgIconoVehiculo"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center"
                    android:background="@drawable/fondo_logo_marca"
                    android:contentDescription="@null"
                    android:padding="6dp"
                    android:scaleType="fitCenter" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtPlacaVehiculo"
                    style="@style/Texto.Subtitulo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/txtDescripcionVehiculo"
                    style="@style/Texto.Secundario"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnMenuVehiculo"
                android:layout_width="@dimen/area_tactil"
                android:layout_height="@dimen/area_tactil"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/jc_cd_opciones_vehiculo"
                android:src="@drawable/ic_dots_three_vertical"
                app:tint="@color/texto_secundario" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtChipVehiculo"
            style="@style/Chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:id="@+id/llEncabezadoHistorial"
            android:layout_width="match_parent"
            android:layout_height="@dimen/area_tactil"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <TextView
                android:id="@+id/txtTituloHistorial"
                style="@style/Texto.Etiqueta"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/imgFlechaHistorial"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_caret_down"
                app:tint="@color/texto_secundario" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/llHistorial"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="12dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/txtSinHistorial"
                style="@style/Texto.Secundario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/jc_sin_historial"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/llOrdenesHistorial"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
