<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <include
        android:id="@+id/encabezado"
        layout="@layout/hoja_encabezado" />

    <ScrollView
        android:id="@+id/svHoja"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="false">

        <LinearLayout
            android:id="@+id/llCamposHoja"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="12dp"
            android:paddingEnd="24dp"
            android:paddingBottom="8dp">

            <LinearLayout
                android:id="@+id/llMarca"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtEtiquetaMarca"
                    style="@style/Campo.Etiqueta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/jc_etq_marca" />

                <EditText
                    android:id="@+id/etMarca"
                    style="@style/Campo.Texto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/jc_hint_marca"
                    android:importantForAutofill="no"
                    android:inputType="textCapWords"
                    android:imeOptions="actionNext" />

                <TextView
                    android:id="@+id/txtErrorMarca"
                    style="@style/Campo.Error"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/llModelo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtEtiquetaModelo"
                    style="@style/Campo.Etiqueta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/jc_etq_modelo" />

                <EditText
                    android:id="@+id/etModelo"
                    style="@style/Campo.Texto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/jc_hint_modelo"
                    android:importantForAutofill="no"
                    android:inputType="textCapWords"
                    android:imeOptions="actionNext" />

                <TextView
                    android:id="@+id/txtErrorModelo"
                    style="@style/Campo.Error"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/llAnio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtEtiquetaAnio"
                    style="@style/Campo.Etiqueta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/jc_etq_anio" />

                <EditText
                    android:id="@+id/etAnio"
                    style="@style/Campo.Texto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/jc_hint_anio"
                    android:importantForAutofill="no"
                    android:inputType="number"
                    android:maxLength="4"
                    android:imeOptions="actionNext" />

                <TextView
                    android:id="@+id/txtErrorAnio"
                    style="@style/Campo.Error"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/llColor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtEtiquetaColor"
                    style="@style/Campo.Etiqueta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/jc_etq_color" />

                <EditText
                    android:id="@+id/etColor"
                    style="@style/Campo.Texto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/jc_hint_color"
                    android:importantForAutofill="no"
                    android:inputType="textCapWords"
                    android:imeOptions="actionDone" />

                <TextView
                    android:id="@+id/txtErrorColor"
                    style="@style/Campo.Error"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/llPlaca"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtEtiquetaPlaca"
                    style="@style/Campo.Etiqueta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/jc_etq_placa" />

                <EditText
                    android:id="@+id/etPlaca"
                    style="@style/Campo.Texto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/jc_hint_placa"
                    android:importantForAutofill="no"
                    android:inputType="textCapCharacters|textNoSuggestions"
                    android:maxLength="7"
                    android:imeOptions="actionNext" />

                <TextView
                    android:id="@+id/txtErrorPlaca"
                    style="@style/Campo.Error"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/btnGuardar"
        style="@style/Boton.Primario"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="24dp"
        android:enabled="false"
        android:text="@string/com_guardar_cambios" />
</LinearLayout>
