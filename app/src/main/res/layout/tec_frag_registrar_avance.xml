<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo"
    android:orientation="vertical">

    <include
        android:id="@+id/barra"
        layout="@layout/include_barra_superior" />

    <ScrollView
        android:id="@+id/svFormulario"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:padding="@dimen/margen_pantalla"
        android:clipToPadding="false"
        android:scrollbars="none">

        <include
            android:id="@+id/formulario"
            layout="@layout/tec_include_form_avance" />
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/margen_pantalla">

        <Button
            android:id="@+id/btnRegistrarAvance"
            style="@style/Boton.Primario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/tec_boton_registrar" />
    </LinearLayout>
</LinearLayout>
