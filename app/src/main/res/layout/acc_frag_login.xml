<?xml version="1.0" encoding="utf-8"?>
<!-- Inicio de sesión: franja de color con saludo e ilustración, y hoja redondeada con los campos. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/superficie">

    <com.leosle.pitlane.vista.acceso.EscenaViaje
        android:id="@+id/escenaLogin"
        android:layout_width="match_parent"
        android:layout_height="292dp" />

    <LinearLayout
        android:id="@+id/llEncabezadoLogin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp">

        <ImageView
            android:id="@+id/imgLogoLogin"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/fondo_logo_acceso"
            android:contentDescription="@string/acc_logo"
            android:padding="8dp"
            android:src="@drawable/acc_logo" />

        <TextView
            android:id="@+id/txtTituloLogin"
            style="@style/Texto.Display"
            android:layout_width="170dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/acc_login_titulo" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/svLogin"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <Space
                android:layout_width="match_parent"
                android:layout_height="292dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/llHojaLogin"
                android:layout_weight="1"
                android:background="@drawable/fondo_hoja_superior"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingTop="24dp"
                android:paddingEnd="24dp"
                android:paddingBottom="16dp">

                <TextView
                    style="@style/Texto.Titulo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/acc_hoja_titulo" />

                <TextView
                    android:id="@+id/txtSubtituloLogin"
                    style="@style/Texto.Secundario"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/acc_login_subtitulo" />

                <LinearLayout
                    android:id="@+id/llCampoCorreo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="vertical">

                    <EditText
                        android:id="@+id/etCorreo"
                        style="@style/Campo.Pildora"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:drawableStart="@drawable/ic_envelope_simple"
                        android:hint="@string/acc_pista_correo"
                        android:importantForAutofill="no"
                        android:inputType="textEmailAddress" />

                    <TextView
                        android:id="@+id/txtErrorCorreo"
                        style="@style/Campo.Error"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/llCampoContrasena"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <EditText
                            android:id="@+id/etContrasena"
                            style="@style/Campo.Pildora"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:drawableStart="@drawable/ic_lock_simple"
                            android:hint="@string/acc_pista_contrasena"
                            android:importantForAutofill="no"
                            android:imeOptions="actionDone"
                            android:inputType="textPassword"
                            android:paddingEnd="52dp" />

                        <ImageButton
                            android:id="@+id/btnVerContrasena"
                            android:layout_width="@dimen/area_tactil"
                            android:layout_height="@dimen/area_tactil"
                            android:layout_gravity="end|center_vertical"
                            android:layout_marginEnd="4dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="@string/acc_ver_contrasena"
                            android:src="@drawable/ic_eye"
                            app:tint="@color/texto_secundario" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/txtErrorContrasena"
                        style="@style/Campo.Error"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnOlvidoContrasena"
                    style="@style/Boton.Texto"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:text="@string/acc_olvido" />

                <TextView
                    android:id="@+id/txtErrorGeneral"
                    style="@style/Campo.Error"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center" />

                <Button
                    android:id="@+id/btnIngresar"
                    style="@style/Boton.Primario"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:enabled="false"
                    android:text="@string/acc_ingresar" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"
                        android:background="@color/contorno" />

                    <TextView
                        android:id="@+id/txtAyudaDemostracion"
                        style="@style/Texto.Pie"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="10dp"
                        android:text="@string/acc_o_demo" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"
                        android:background="@color/contorno" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/mcvCuentasDemostracion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <Spinner
                        android:id="@+id/spnCuentaDemostracion"
                        style="@style/Campo.Combo"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <Button
                        android:id="@+id/btnUsarCuentaDemostracion"
                        style="@style/Boton.Secundario"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="@string/acc_demo_usar" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Texto.Secundario"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/acc_sin_cuenta" />

                    <Button
                        android:id="@+id/btnCrearCuenta"
                        style="@style/Boton.Texto"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/acc_crear_cuenta_enlace" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
