<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp">

    <ImageView
        android:id="@+id/imgLogoSplash"
        android:layout_width="132dp"
        android:layout_height="132dp"
        android:contentDescription="@string/acc_logo"
        android:src="@drawable/acc_logo_animado" />

    <TextView
        android:id="@+id/txtNombreApp"
        style="@style/Texto.Display"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:text="@string/acc_nombre_app" />

    <TextView
        android:id="@+id/txtLemaApp"
        style="@style/Texto.Secundario"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="@string/acc_lema_app" />
</LinearLayout>
