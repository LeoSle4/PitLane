<?xml version="1.0" encoding="utf-8"?>
<!-- Fila de la lista de vehículos: barra lateral del color del estado, placa, datos, chip y menú de opciones. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mcvVehiculo"
    style="@style/Tarjeta"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <View
            android:id="@+id/viewBarraEstado"
            android:layout_width="6dp"
            android:layout_height="match_parent"
            android:background="@drawable/cli_barra_estado" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="12dp"
            android:paddingEnd="4dp"
            android:paddingBottom="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/imgMarcaVehiculo"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/fondo_logo_marca"
                    android:contentDescription="@null"
                    android:padding="6dp"
                android:scaleType="fitCenter" />

                <TextView
                    android:id="@+id/txtPlaca"
                    style="@style/Texto.Titulo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:maxLines="1" />

                <ImageButton
                    android:id="@+id/btnMenuVehiculo"
                    android:layout_width="@dimen/area_tactil"
                    android:layout_height="@dimen/area_tactil"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/cli_mas_opciones"
                    android:focusable="false"
                    android:src="@drawable/ic_dots_three_vertical"
                    app:tint="@color/texto_secundario" />
            </LinearLayout>

            <TextView
                android:id="@+id/txtDescripcionVehiculo"
                style="@style/Texto.Cuerpo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:ellipsize="end"
                android:maxLines="1" />

            <TextView
                android:id="@+id/txtEstadoVehiculo"
                style="@style/Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
