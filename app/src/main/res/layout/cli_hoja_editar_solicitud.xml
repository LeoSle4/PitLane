<?xml version="1.0" encoding="utf-8"?>
<!-- Hoja inferior para editar una solicitud pendiente: el vehículo aparece bloqueado y el botón se activa al haber cambios. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <include
        android:id="@+id/encabezado"
        layout="@layout/hoja_encabezado" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/svEdicionSolicitud"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                style="@style/Campo.Etiqueta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cli_etiqueta_vehiculo" />

            <EditText
                android:id="@+id/etVehiculoBloqueado"
                style="@style/Campo.Texto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:importantForAutofill="no"
                android:inputType="text" />

            <include
                android:id="@+id/formulario"
                layout="@layout/cli_include_formulario_solicitud"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp" />

            <Button
                android:id="@+id/btnGuardar"
                style="@style/Boton.Primario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:enabled="false"
                android:text="@string/com_guardar_cambios" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
