<?xml version="1.0" encoding="utf-8"?>
<!-- Fila informativa de una lista agrupada: ícono, nombre a la izquierda y valor a la derecha. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="52dp"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">

    <ImageView
        android:id="@+id/imgIconoDato"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:contentDescription="@null"
        app:tint="@color/texto_primario" />

    <TextView
        android:id="@+id/txtEtiquetaDato"
        style="@style/Texto.Cuerpo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/txtValorDato"
        style="@style/Texto.Secundario"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />
</LinearLayout>
