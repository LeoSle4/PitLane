<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include
        android:id="@+id/barraSuperior"
        layout="@layout/include_barra_superior" />

    <LinearLayout
        android:id="@+id/llFormularioRecuperar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/margen_pantalla"
        android:paddingEnd="@dimen/margen_pantalla">

        <TextView
            android:id="@+id/txtIntroRecuperar"
            style="@style/Texto.Secundario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/acc_recuperar_intro" />

            <LinearLayout
                android:id="@+id/llCampoCorreoRecuperar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="vertical">

                <TextView
                    style="@style/Campo.Etiqueta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/acc_etiqueta_correorecuperar" />

                <EditText
                    android:id="@+id/etCorreoRecuperar"
                    style="@style/Campo.Texto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/acc_pista_correorecuperar"
                    android:importantForAutofill="no"
                    android:inputType="textEmailAddress" />

                <TextView
                    android:id="@+id/txtErrorCorreoRecuperar"
                    style="@style/Campo.Error"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

        <Button
            android:id="@+id/btnEnviarEnlace"
            style="@style/Boton.Primario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/acc_enviar_enlace" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/llExitoRecuperar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/imgExitoRecuperar"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/txtTituloExito"
            style="@style/Texto.Titulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/acc_revisa_correo" />

        <TextView
            android:id="@+id/txtMensajeExito"
            style="@style/Texto.Secundario"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/acc_revisa_correo_detalle" />

        <Button
            android:id="@+id/btnVolverIngresar"
            style="@style/Boton.Primario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/acc_volver_ingresar" />
    </LinearLayout>
</LinearLayout>
