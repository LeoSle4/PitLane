<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include
        android:id="@+id/barraSuperior"
        layout="@layout/include_barra_superior" />

    <LinearLayout
        android:id="@+id/llFormularioRecuperar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/margen_pantalla"
        android:paddingEnd="@dimen/margen_pantalla">

        <TextView
            android:id="@+id/txtIntroRecuperar"
            style="@style/Texto.Secundario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/acc_recuperar_intro" />

            <LinearLayout
                android:id="@+id/llCampoCorreoRecuperar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="vertical">

                <TextView
                    style="@style/Campo.Etiqueta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/acc_etiqueta_correorecuperar" />

                <EditText
                    android:id="@+id/etCorreoRecuperar"
                    style="@style/Campo.Texto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/acc_pista_correorecuperar"
                    android:importantForAutofill="no"
                    android:inputType="textEmailAddress" />

                <TextView
                    android:id="@+id/txtErrorCorreoRecuperar"
                    style="@style/Campo.Error"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

        <Button
            android:id="@+id/btnEnviarCodigo"
            style="@style/Boton.Primario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/acc_enviar_codigo" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/svCodigoRecuperar"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/margen_pantalla"
            android:paddingEnd="@dimen/margen_pantalla"
            android:paddingBottom="24dp">

            <TextView
                android:id="@+id/txtIntroCodigo"
                style="@style/Texto.Secundario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                style="@style/Campo.Etiqueta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/acc_etiqueta_codigo" />

            <EditText
                android:id="@+id/etCodigo"
                style="@style/Campo.Texto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/acc_pista_codigo"
                android:importantForAutofill="yes"
                android:autofillHints="smsOTPCode"
                android:inputType="number"
                android:letterSpacing="0.3"
                android:maxLength="6" />

            <TextView
                android:id="@+id/txtErrorCodigo"
                style="@style/Campo.Error"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                style="@style/Campo.Etiqueta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/acc_etiqueta_nueva_contrasena" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <EditText
                    android:id="@+id/etNuevaContrasena"
                    style="@style/Campo.Texto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/acc_pista_nueva_contrasena"
                    android:importantForAutofill="no"
                    android:inputType="textPassword"
                    android:paddingEnd="52dp" />

                <ImageButton
                    android:id="@+id/btnVerNuevaContrasena"
                    android:layout_width="@dimen/area_tactil"
                    android:layout_height="@dimen/area_tactil"
                    android:layout_gravity="end|center_vertical"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/acc_ver_contrasena"
                    android:src="@drawable/ic_eye"
                    app:tint="@color/texto_secundario" />
            </FrameLayout>

            <TextView
                android:id="@+id/txtErrorNuevaContrasena"
                style="@style/Campo.Error"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                style="@style/Campo.Etiqueta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/acc_etiqueta_confirmar_nueva" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <EditText
                    android:id="@+id/etConfirmarNueva"
                    style="@style/Campo.Texto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:importantForAutofill="no"
                    android:inputType="textPassword"
                    android:paddingEnd="52dp" />

                <ImageButton
                    android:id="@+id/btnVerConfirmarNueva"
                    android:layout_width="@dimen/area_tactil"
                    android:layout_height="@dimen/area_tactil"
                    android:layout_gravity="end|center_vertical"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/acc_ver_contrasena"
                    android:src="@drawable/ic_eye"
                    app:tint="@color/texto_secundario" />
            </FrameLayout>

            <TextView
                android:id="@+id/txtErrorConfirmarNueva"
                style="@style/Campo.Error"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <Button
                android:id="@+id/btnCambiarContrasena"
                style="@style/Boton.Primario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/acc_cambiar_contrasena" />

            <Button
                android:id="@+id/btnReenviarCodigo"
                style="@style/Boton.Texto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/acc_reenviar_codigo" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/llExitoRecuperar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/imgExitoRecuperar"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/txtTituloExito"
            style="@style/Texto.Titulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/acc_contrasena_actualizada" />

        <TextView
            android:id="@+id/txtMensajeExito"
            style="@style/Texto.Secundario"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/acc_contrasena_actualizada_detalle" />

        <Button
            android:id="@+id/btnVolverIngresar"
            style="@style/Boton.Primario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/acc_volver_ingresar" />
    </LinearLayout>
</LinearLayout>
