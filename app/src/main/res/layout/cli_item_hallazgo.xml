<?xml version="1.0" encoding="utf-8"?>
<!-- Tarjeta de un avance: ícono y etiqueta del tipo, descripción, galería horizontal de fotos, fecha y técnico. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mcvHallazgo"
    style="@style/Tarjeta"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/imgIconoTipo"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/fondo_circulo_suave"
                android:contentDescription="@null"
                android:padding="9dp"
                app:tint="@color/sobre_contenedor_primario" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtTipoHallazgo"
                    style="@style/Texto.Subtitulo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/txtFechaHallazgo"
                    style="@style/Texto.Pie"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/txtDescripcionHallazgo"
            style="@style/Texto.Cuerpo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp" />

        <HorizontalScrollView
            android:id="@+id/hsvGaleria"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/llGaleria"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <TextView
            android:id="@+id/txtTecnicoHallazgo"
            style="@style/Texto.Pie"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
