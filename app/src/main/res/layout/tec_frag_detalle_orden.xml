<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo"
    android:orientation="vertical">

    <include
        android:id="@+id/barra"
        layout="@layout/include_barra_superior" />

    <!-- Resumen de la orden: número, estado y vehículo -->
    <LinearLayout
        android:id="@+id/llResumenOrden"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margen_pantalla"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="@dimen/margen_pantalla"
        android:background="@drawable/fondo_encabezado"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtNumeroResumen"
                style="@style/Texto.Subtitulo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/sobre_primario" />

            <TextView
                android:id="@+id/txtEstadoResumen"
                style="@style/Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtPlacaResumen"
            style="@style/Texto.Display"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textSize="22sp"
            android:textColor="@color/sobre_primario" />

        <TextView
            android:id="@+id/txtVehiculoResumen"
            style="@style/Texto.Cuerpo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/sobre_primario" />
    </LinearLayout>

    <!-- Selector de sección: Detalle o Avances -->
    <RadioGroup
        android:id="@+id/rgSeccion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margen_pantalla"
        android:layout_marginTop="@dimen/espacio_8"
        android:layout_marginEnd="@dimen/margen_pantalla"
        android:orientation="horizontal">

        <RadioButton
            android:id="@+id/rbSeccionDetalle"
            style="@style/Campo.Opcion"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:checked="true"
            android:text="@string/tec_seccion_detalle" />

        <RadioButton
            android:id="@+id/rbSeccionAvances"
            style="@style/Campo.Opcion"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="0dp"
            android:layout_weight="1"
            android:text="@string/tec_seccion_avances" />
    </RadioGroup>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Sección Detalle -->
        <ScrollView
            android:id="@+id/svDetalle"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/margen_pantalla"
                android:paddingTop="4dp"
                android:paddingEnd="@dimen/margen_pantalla"
                android:paddingBottom="@dimen/espacio_24">

                <com.google.android.material.card.MaterialCardView
                    style="@style/Tarjeta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            style="@style/Texto.Etiqueta"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/tec_etiqueta_falla"
                            android:textColor="@color/texto_secundario" />

                        <TextView
                            android:id="@+id/txtFallaDetalle"
                            style="@style/Texto.Cuerpo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp" />

                        <LinearLayout
                            android:id="@+id/llFotosSolicitud"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:orientation="vertical"
                            android:visibility="gone">

                            <TextView
                                style="@style/Texto.Etiqueta"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="6dp"
                                android:text="@string/tec_etiqueta_fotos_solicitud"
                                android:textColor="@color/texto_secundario" />

                            <HorizontalScrollView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:scrollbars="none">

                                <LinearLayout
                                    android:id="@+id/llMiniaturasSolicitud"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal" />
                            </HorizontalScrollView>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    style="@style/Tarjeta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">

                    <LinearLayout
                        android:id="@+id/llDatosIngreso"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp" />
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    style="@style/Tarjeta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            style="@style/Texto.Etiqueta"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/tec_etiqueta_observaciones"
                            android:textColor="@color/texto_secundario" />

                        <TextView
                            android:id="@+id/txtObservacionesDetalle"
                            style="@style/Texto.Cuerpo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp" />

                        <TextView
                            style="@style/Texto.Etiqueta"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:layout_marginBottom="6dp"
                            android:text="@string/tec_etiqueta_fotos_exterior"
                            android:textColor="@color/texto_secundario" />

                        <HorizontalScrollView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:scrollbars="none">

                            <LinearLayout
                                android:id="@+id/llMiniaturasExterior"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal" />
                        </HorizontalScrollView>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    style="@style/Texto.Subtitulo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/tec_etiqueta_previas" />

                <com.google.android.material.card.MaterialCardView
                    style="@style/Tarjeta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp">

                        <LinearLayout
                            android:id="@+id/llOrdenesPrevias"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />

                        <TextView
                            android:id="@+id/txtSinPrevias"
                            style="@style/Texto.Secundario"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingTop="16dp"
                            android:paddingBottom="16dp"
                            android:text="@string/tec_sin_previas"
                            android:visibility="gone" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </ScrollView>

        <!-- Sección Avances -->
        <FrameLayout
            android:id="@+id/flAvances"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <ListView
                android:id="@+id/lvAvances"
                style="@style/Lista"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingStart="@dimen/margen_pantalla"
                android:paddingTop="12dp"
                android:paddingEnd="@dimen/margen_pantalla"
                android:paddingBottom="@dimen/espacio_16" />

            <include
                android:id="@+id/vacioAvances"
                layout="@layout/include_estado_vacio" />
        </FrameLayout>
    </FrameLayout>

    <!-- Acciones según el estado de la orden -->
    <LinearLayout
        android:id="@+id/llAcciones"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/margen_pantalla"
        android:paddingTop="@dimen/espacio_12"
        android:paddingEnd="@dimen/margen_pantalla"
        android:paddingBottom="@dimen/espacio_12">

        <Button
            android:id="@+id/btnAccionPrincipal"
            style="@style/Boton.Primario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <Button
            android:id="@+id/btnMarcarListo"
            style="@style/Boton.Secundario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/tec_boton_marcar_listo"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
