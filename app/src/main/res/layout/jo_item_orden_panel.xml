<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/margen_pantalla"
    android:paddingTop="6dp"
    android:paddingEnd="@dimen/margen_pantalla"
    android:paddingBottom="6dp">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/mcvOrden"
        style="@style/Tarjeta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clickable="false"
        android:focusable="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- Barra lateral con el color del estado -->
            <View
                android:id="@+id/viewBarraEstado"
                android:layout_width="6dp"
                android:layout_height="match_parent" />
            <ImageView
                android:id="@+id/imgMarcaOrden"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/fondo_logo_marca"
                android:padding="6dp"
                android:layout_gravity="top"
                android:layout_marginStart="12dp"
                android:layout_marginTop="16dp"
                android:contentDescription="@null"
                android:scaleType="fitCenter" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/txtNumeroOrden"
                        style="@style/Texto.Etiqueta"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/texto_secundario" />

                    <TextView
                        android:id="@+id/txtTiempoEstado"
                        style="@style/Texto.Etiqueta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:drawablePadding="4dp"
                        android:drawableTint="@color/texto_secundario"
                        android:gravity="center_vertical"
                        android:textColor="@color/texto_secundario"
                        app:drawableStartCompat="@drawable/ic_clock" />
                </LinearLayout>

                <TextView
                    android:id="@+id/txtPlacaOrden"
                    style="@style/Texto.Titulo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:id="@+id/txtVehiculoOrden"
                    style="@style/Texto.Secundario"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/txtClienteOrden"
                    style="@style/Texto.Cuerpo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:drawablePadding="8dp"
                    android:drawableTint="@color/texto_secundario"
                    android:gravity="center_vertical"
                    app:drawableStartCompat="@drawable/ic_user" />

                <TextView
                    android:id="@+id/txtTecnicoOrden"
                    style="@style/Texto.Cuerpo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:drawablePadding="8dp"
                    android:drawableTint="@color/texto_secundario"
                    android:gravity="center_vertical"
                    app:drawableStartCompat="@drawable/ic_wrench" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</FrameLayout>
