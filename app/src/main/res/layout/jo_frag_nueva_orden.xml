<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo"
    android:orientation="vertical">

    <include
        android:id="@+id/incBarra"
        layout="@layout/include_barra_superior"
        android:layout_width="match_parent"
        android:layout_height="@dimen/alto_barra_superior" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/margen_pantalla"
        android:paddingEnd="@dimen/margen_pantalla">

        <TextView
            android:id="@+id/txtPasoOrden"
            style="@style/Texto.Etiqueta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/texto_secundario" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <View
                android:id="@+id/viewBarraOrdenUno"
                android:layout_width="0dp"
                android:layout_height="4dp"
                android:layout_marginEnd="3dp"
                android:layout_weight="1"
                android:background="@drawable/fondo_linea_tiempo" />

            <View
                android:id="@+id/viewBarraOrdenDos"
                android:layout_width="0dp"
                android:layout_height="4dp"
                android:layout_marginStart="3dp"
                android:layout_marginEnd="3dp"
                android:layout_weight="1"
                android:background="@drawable/fondo_linea_tiempo" />

            <View
                android:id="@+id/viewBarraOrdenTres"
                android:layout_width="0dp"
                android:layout_height="4dp"
                android:layout_marginStart="3dp"
                android:layout_weight="1"
                android:background="@drawable/fondo_linea_tiempo" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:id="@+id/svNuevaOrden"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="false"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/margen_pantalla">

            <!-- Sección Cliente -->
            <LinearLayout
                android:id="@+id/llPasoCliente"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/mcvCliente"
                style="@style/Tarjeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        style="@style/Jo.Seccion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/jo_seccion_cliente" />

                    <EditText
                        android:id="@+id/etBuscarCliente"
                        style="@style/Campo.Texto"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:drawablePadding="8dp"
                        android:drawableStart="@drawable/ic_magnifying_glass"
                        android:drawableTint="@color/texto_secundario"
                        android:hint="@string/jo_buscar_cliente"
                        android:importantForAutofill="no"
                        android:inputType="text"
                        android:maxLines="1" />

                    <Spinner
                        android:id="@+id/spnCliente"
                        style="@style/Campo.Combo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <TextView
                        android:id="@+id/txtErrorCliente"
                        style="@style/Campo.Error"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Sección Vehículo -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/mcvVehiculo"
                style="@style/Tarjeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        style="@style/Jo.Seccion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/jo_seccion_vehiculo" />

                    <Spinner
                        android:id="@+id/spnVehiculo"
                        style="@style/Campo.Combo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <TextView
                        android:id="@+id/txtErrorVehiculo"
                        style="@style/Campo.Error"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                    <LinearLayout
                        android:id="@+id/llSinVehiculosOrden"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            style="@style/Texto.Secundario"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Este cliente aún no tiene vehículos registrados." />

                        <Button
                            android:id="@+id/btnAgregarVehiculoOrden"
                            style="@style/Boton.Secundario"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="Agregar vehículo"
                            app:icon="@drawable/ic_plus" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Sección Falla -->
            <LinearLayout
                android:id="@+id/llPasoIngreso"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/mcvFalla"
                style="@style/Tarjeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        style="@style/Jo.Seccion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/jo_seccion_falla" />

                    <EditText
                        android:id="@+id/etFalla"
                        style="@style/Campo.Texto"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="top|start"
                        android:hint="@string/jo_hint_falla"
                        android:importantForAutofill="no"
                        android:inputType="textCapSentences|textMultiLine"
                        android:minLines="3" />

                    <TextView
                        android:id="@+id/txtErrorFalla"
                        style="@style/Campo.Error"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Sección Estado del vehículo -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/mcvEstado"
                style="@style/Tarjeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        style="@style/Jo.Seccion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/jo_seccion_estado" />

                    <TextView
                        style="@style/Campo.Etiqueta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/jo_etiqueta_kilometraje" />

                    <EditText
                        android:id="@+id/etKilometraje"
                        style="@style/Campo.Texto"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/jo_hint_kilometraje"
                        android:importantForAutofill="no"
                        android:inputType="number"
                        android:maxLength="7" />

                    <TextView
                        android:id="@+id/txtErrorKilometraje"
                        style="@style/Campo.Error"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                    <TextView
                        style="@style/Campo.Etiqueta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@string/jo_etiqueta_combustible" />

                    <include
                        android:id="@+id/incCombustible"
                        layout="@layout/jo_include_combustible"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <TextView
                        android:id="@+id/txtErrorCombustible"
                        style="@style/Campo.Error"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="0dp" />

                    <TextView
                        style="@style/Campo.Etiqueta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/jo_etiqueta_observaciones" />

                    <EditText
                        android:id="@+id/etObservaciones"
                        style="@style/Campo.Texto"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="top|start"
                        android:hint="@string/jo_hint_observaciones"
                        android:importantForAutofill="no"
                        android:inputType="textCapSentences|textMultiLine"
                        android:minLines="2" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Sección Fotos -->
            <LinearLayout
                android:id="@+id/llPasoFotos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/mcvFotos"
                style="@style/Tarjeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        style="@style/Jo.Seccion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/jo_seccion_fotos" />

                    <include
                        android:id="@+id/incFotos"
                        layout="@layout/include_zona_fotos"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <TextView
                        android:id="@+id/txtErrorFotos"
                        style="@style/Campo.Error"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Sección Técnico -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/mcvTecnico"
                style="@style/Tarjeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        style="@style/Jo.Seccion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/jo_seccion_tecnico" />

                    <Spinner
                        android:id="@+id/spnTecnico"
                        style="@style/Campo.Combo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <TextView
                        android:id="@+id/txtErrorTecnico"
                        style="@style/Campo.Error"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Barra inferior fija con el botón principal -->
    <LinearLayout
        android:id="@+id/llAccionNuevaOrden"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/fondo"
        android:orientation="vertical"
        android:padding="@dimen/margen_pantalla">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnAtrasOrden"
                style="@style/Boton.Secundario"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:text="Atrás" />

            <Button
                android:id="@+id/btnSiguienteOrden"
                style="@style/Boton.Primario"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Siguiente" />

            <Button
                android:id="@+id/btnRegistrarOrden"
                style="@style/Boton.Primario"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/jo_registrar_ingreso" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
