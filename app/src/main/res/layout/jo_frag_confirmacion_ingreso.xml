<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo"
    android:orientation="vertical">

    <ScrollView
        android:id="@+id/svConfirmacion"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="@dimen/margen_pantalla"
            android:paddingTop="@dimen/espacio_32"
            android:paddingEnd="@dimen/margen_pantalla"
            android:paddingBottom="@dimen/espacio_16">

            <!-- Check animado de éxito -->
            <ImageView
                android:id="@+id/imgCheckIngreso"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:contentDescription="Ingreso registrado"
                android:src="@drawable/vector_check_circulo" />

            <TextView
                android:id="@+id/txtTituloConfirmacion"
                style="@style/Texto.Titulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/jo_confirmacion_titulo" />

            <TextView
                android:id="@+id/txtEtiquetaNumero"
                style="@style/Texto.Secundario"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/jo_confirmacion_orden" />

            <!-- Número de orden grande dentro de un ticket -->
            <TextView
                android:id="@+id/txtNumeroConfirmacion"
                style="@style/Texto.Display"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/fondo_ticket"
                android:paddingStart="32dp"
                android:paddingTop="16dp"
                android:paddingEnd="32dp"
                android:paddingBottom="16dp"
                android:textSize="36sp" />

            <TextView
                android:id="@+id/txtMensajeNotificacion"
                style="@style/Texto.Cuerpo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center" />

            <TextView
                android:id="@+id/txtEtiquetaVistaPrevia"
                style="@style/Texto.Etiqueta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/jo_confirmacion_vista_previa"
                android:textColor="@color/texto_secundario"
                android:visibility="gone" />

            <!-- Tarjeta que simula el aviso recibido por el cliente -->
            <include
                android:id="@+id/incVistaPrevia"
                layout="@layout/include_aviso_push"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/margen_pantalla">

        <Button
            android:id="@+id/btnVerOrden"
            style="@style/Boton.Primario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/jo_ver_orden" />

        <Button
            android:id="@+id/btnIrPanel"
            style="@style/Boton.Secundario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/jo_ir_panel" />
    </LinearLayout>
</LinearLayout>
