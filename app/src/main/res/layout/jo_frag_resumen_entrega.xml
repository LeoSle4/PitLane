<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo"
    android:orientation="vertical">

    <include
        android:id="@+id/incBarra"
        layout="@layout/include_barra_superior"
        android:layout_width="match_parent"
        android:layout_height="@dimen/alto_barra_superior" />

    <!-- Falla reportada y técnico que atendió la orden -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/mcvCabeceraResumen"
        style="@style/Tarjeta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margen_pantalla"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="@dimen/margen_pantalla">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/txtEtiquetaFallaResumen"
                style="@style/Jo.Seccion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/jo_resumen_falla" />

            <TextView
                android:id="@+id/txtFallaResumen"
                style="@style/Jo.Valor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/txtEtiquetaTecnicoResumen"
                style="@style/Jo.Seccion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/jo_resumen_tecnico" />

            <TextView
                android:id="@+id/txtTecnicoResumen"
                style="@style/Jo.Valor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/txtSeccionResumen"
        style="@style/Jo.Seccion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margen_pantalla"
        android:layout_marginTop="@dimen/espacio_16"
        android:layout_marginEnd="@dimen/margen_pantalla"
        android:text="@string/jo_resumen_seccion" />

    <!-- Hallazgos y trabajos realizados en orden cronológico, solo de lectura -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/lvResumen"
            style="@style/Lista.Espaciada"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="@dimen/margen_pantalla"
            android:paddingTop="@dimen/espacio_8"
            android:paddingEnd="@dimen/margen_pantalla"
            android:paddingBottom="@dimen/espacio_24" />

        <include
            android:id="@+id/incVacio"
            layout="@layout/include_estado_vacio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center" />
    </FrameLayout>
</LinearLayout>
