<?xml version="1.0" encoding="utf-8"?>
<!-- Pestaña de solicitudes: título con botón de nueva solicitud y lista con estado vacío. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/margen_pantalla"
        android:paddingTop="@dimen/espacio_16"
        android:paddingEnd="@dimen/margen_pantalla"
        android:paddingBottom="@dimen/espacio_8">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtTituloSolicitudes"
                style="@style/Texto.Display"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/cli_solicitudes_titulo" />

            <TextView
                android:id="@+id/txtSubtituloSolicitudes"
                style="@style/Texto.Secundario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/cli_solicitudes_subtitulo" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnNuevaSolicitud"
            android:layout_width="@dimen/area_tactil"
            android:layout_height="@dimen/area_tactil"
            android:layout_marginStart="12dp"
            android:background="@drawable/fondo_punto_primario"
            android:contentDescription="@string/cli_nueva_solicitud"
            android:src="@drawable/ic_plus"
            app:tint="@color/sobre_primario" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/lvSolicitudes"
            style="@style/Lista.Espaciada"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="@dimen/margen_pantalla"
            android:paddingTop="@dimen/espacio_8"
            android:paddingEnd="@dimen/margen_pantalla"
            android:paddingBottom="@dimen/relleno_lista_con_barra" />

        <include
            android:id="@+id/incVacio"
            layout="@layout/include_estado_vacio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center" />
    </FrameLayout>
</LinearLayout>
