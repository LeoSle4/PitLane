<?xml version="1.0" encoding="utf-8"?>
<!-- Registro en dos pasos: escena de viaje arriba y hoja redondeada con los datos personales y luego los de la cuenta. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/superficie">

    <com.leosle.pitlane.vista.acceso.EscenaViaje
        android:id="@+id/escenaRegistro"
        android:layout_width="match_parent"
        android:layout_height="292dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <Space
            android:id="@+id/spcSuperiorRegistro"
            android:layout_width="match_parent"
            android:layout_height="292dp" />

        <LinearLayout
            android:id="@+id/llHojaRegistro"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/fondo_hoja_superior"
            android:orientation="vertical"
            android:paddingTop="8dp">

            <include
                android:id="@+id/barraSuperior"
                layout="@layout/include_barra_superior" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingEnd="24dp">

                <TextView
                    android:id="@+id/txtPasoRegistro"
                    style="@style/Texto.Etiqueta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/texto_secundario" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <View
                        android:id="@+id/viewBarraPasoUno"
                        android:layout_width="0dp"
                        android:layout_height="4dp"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/fondo_linea_tiempo" />

                    <View
                        android:id="@+id/viewBarraPasoDos"
                        android:layout_width="0dp"
                        android:layout_height="4dp"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/fondo_linea_tiempo" />
                </LinearLayout>
            </LinearLayout>

            <ScrollView
                android:id="@+id/svRegistro"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:scrollbars="none">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="24dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="24dp">

                    <LinearLayout
                        android:id="@+id/llPasoDatos"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/txtIntroRegistro"
                            style="@style/Texto.Secundario"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/acc_registro_intro" />

                        <LinearLayout
                            android:id="@+id/llCampoNombres"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:orientation="vertical">

                            <EditText
                                android:id="@+id/etNombres"
                                style="@style/Campo.Pildora"
                                        android:drawableStart="@drawable/ic_user"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="@string/acc_campo_nombres"
                                android:importantForAutofill="no"
                                android:inputType="textPersonName|textCapWords" />

                            <TextView
                                android:id="@+id/txtErrorNombres"
                                style="@style/Campo.Error"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" />
                        </LinearLayout>
                        <LinearLayout
                            android:id="@+id/llCampoApellidos"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:orientation="vertical">

                            <EditText
                                android:id="@+id/etApellidos"
                                style="@style/Campo.Pildora"
                                        android:drawableStart="@drawable/ic_user"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="@string/acc_campo_apellidos"
                                android:importantForAutofill="no"
                                android:inputType="textPersonName|textCapWords" />

                            <TextView
                                android:id="@+id/txtErrorApellidos"
                                style="@style/Campo.Error"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" />
                        </LinearLayout>
                        <LinearLayout
                            android:id="@+id/llCampoDni"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:orientation="vertical">

                            <EditText
                                android:id="@+id/etDni"
                                style="@style/Campo.Pildora"
                                        android:drawableStart="@drawable/ic_identification_card"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="@string/acc_campo_dni"
                                android:importantForAutofill="no"
                                android:inputType="number"
                                android:maxLength="8" />

                            <TextView
                                android:id="@+id/txtErrorDni"
                                style="@style/Campo.Error"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" />
                        </LinearLayout>
                        <LinearLayout
                            android:id="@+id/llCampoTelefono"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:orientation="vertical">

                            <EditText
                                android:id="@+id/etTelefono"
                                style="@style/Campo.Pildora"
                                        android:drawableStart="@drawable/ic_phone"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="@string/acc_campo_telefono"
                                android:importantForAutofill="no"
                                android:inputType="phone"
                                android:maxLength="9" />

                            <TextView
                                android:id="@+id/txtErrorTelefono"
                                style="@style/Campo.Error"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/llPasoCuenta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <LinearLayout
                            android:id="@+id/llCampoCorreoRegistro"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:orientation="vertical">

                            <EditText
                                android:id="@+id/etCorreoRegistro"
                                style="@style/Campo.Pildora"
                                        android:drawableStart="@drawable/ic_envelope_simple"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="@string/acc_campo_correo_registro"
                                android:importantForAutofill="no"
                                android:inputType="textEmailAddress" />

                            <TextView
                                android:id="@+id/txtErrorCorreoRegistro"
                                style="@style/Campo.Error"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" />
                        </LinearLayout>
                        <LinearLayout
                            android:id="@+id/llCampoContrasenaRegistro"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:orientation="vertical">

                            <FrameLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content">

                                <EditText
                                    android:id="@+id/etContrasenaRegistro"
                                    style="@style/Campo.Pildora"
                                        android:drawableStart="@drawable/ic_lock_simple"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:hint="@string/acc_campo_contrasena_registro"
                                    android:importantForAutofill="no"
                                    android:inputType="textPassword"
                                    android:paddingEnd="52dp" />

                                <ImageButton
                                    android:id="@+id/btnVerContrasenaRegistro"
                                    android:layout_width="@dimen/area_tactil"
                                    android:layout_height="@dimen/area_tactil"
                                    android:layout_gravity="end|center_vertical"
                                    android:background="?attr/selectableItemBackgroundBorderless"
                                    android:contentDescription="@string/acc_ver_contrasena"
                                    android:src="@drawable/ic_eye"
                                    app:tint="@color/texto_secundario" />
                            </FrameLayout>

                            <TextView
                                android:id="@+id/txtErrorContrasenaRegistro"
                                style="@style/Campo.Error"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" />
                        </LinearLayout>
                        <LinearLayout
                            android:id="@+id/llCampoConfirmacion"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:orientation="vertical">

                            <FrameLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content">

                                <EditText
                                    android:id="@+id/etConfirmacion"
                                    style="@style/Campo.Pildora"
                                        android:drawableStart="@drawable/ic_lock_simple"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:hint="@string/acc_campo_confirmacion"
                                    android:importantForAutofill="no"
                                    android:inputType="textPassword"
                                    android:paddingEnd="52dp" />

                                <ImageButton
                                    android:id="@+id/btnVerConfirmacion"
                                    android:layout_width="@dimen/area_tactil"
                                    android:layout_height="@dimen/area_tactil"
                                    android:layout_gravity="end|center_vertical"
                                    android:background="?attr/selectableItemBackgroundBorderless"
                                    android:contentDescription="@string/acc_ver_contrasena"
                                    android:src="@drawable/ic_eye"
                                    app:tint="@color/texto_secundario" />
                            </FrameLayout>

                            <TextView
                                android:id="@+id/txtErrorConfirmacion"
                                style="@style/Campo.Error"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" />
                        </LinearLayout>
                        <CheckBox
                            android:id="@+id/chkTerminos"
                            style="@style/Campo.Casilla"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="@string/acc_terminos" />

                    </LinearLayout>
                </FrameLayout>
            </ScrollView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="24dp">

                <Button
                    android:id="@+id/btnAtrasRegistro"
                    style="@style/Boton.Secundario"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp"
                    android:text="Atrás" />

                <Button
                    android:id="@+id/btnSiguienteRegistro"
                    style="@style/Boton.Primario"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Siguiente" />

                <Button
                    android:id="@+id/btnRegistrarCuenta"
                    style="@style/Boton.Primario"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/acc_crear_cuenta" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
