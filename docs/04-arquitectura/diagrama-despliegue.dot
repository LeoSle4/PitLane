  A_FN [shape=note, style=filled, fillcolor="#FFF3E0", color="#E65100", fixedsize=true, width=4.9, height=1.45, label="index.js · Node.js 20 · firebase-admin\ninvocables: crearTecnico, desactivarCuenta,\nunirClienteConDni\ndisparador de Firestore: notificarOrden\n(Entregado no genera aviso)", group="g_fs"];
  edge [style=invis];
  A_BUILD -> A_CLI -> A_WS;
  M_dev -> p4; p4 -> M5 [minlen=3]; M5 -> M6 -> M7 -> T4; T5 -> A_FN;
  T_ST -> A_FOTOS; T_FCM -> L_FCM -> Bb_FCM; T_FS -> DB -> Bb_FS; T_AUTH -> A_USERS -> Bb_AUTH;
  edge [style=solid];
  A_WS -> pB [weight=50];
  p1 -> T_AUTH [minlen=3, weight=50]; p2 -> T_ST [minlen=3, weight=50]; p3 -> T_FS [minlen=3, weight=50]; p8 -> T_FCM [minlen=3, weight=50]; p4 -> T4 [minlen=6, weight=50];
  Bb_FS -> T5 [weight=50]; Bb_AUTH -> T6 [weight=50]; Bb_FCM -> T7 [weight=50];
}