  GPS [shape=note, style=filled, fillcolor="#FFF3E0", color="#E65100", fixedsize=true, width=2.9, height=0.75, label="Google Play services\ncliente de mensajes push"];
  { rank=same; A_BUILD -> s_wd -> APK -> M_dev -> GPS [style=invis]; }
  A_CLI [shape=note, style=filled, fillcolor="#FFF3E0", color="#E65100", fixedsize=true, width=3.0, height=0.75, label="Firebase CLI\nfirebase deploy", group="g_B"];
