  DB [shape=cylinder, style=filled, fillcolor="#E8F5E9", color="#2E7D32", fixedsize=true, width=2.3, height=1.1, label="BD NoSQL\n(6 colecciones\n+ contador de órdenes)", group="g_fs"];
