digraph despliegue {
  graph [rankdir=TB, splines=ortho, newrank=true, nodesep=0.45, ranksep=0.7, fontname="Arial", pad=0.4,
         ];
  node [fontname="Arial", fontsize=12];
  edge [color="#424242", penwidth=1.2, arrowhead=none];
  A_BUILD [shape=note, style=filled, fillcolor="#FFF3E0", color="#E65100", fixedsize=true, width=3.0, height=0.75, label="Android Studio · Gradle\nservicio-electrico-freddy.apk", group="g_B"];
  s_wd [shape=box, style=filled, fillcolor="#FFFFFF00", color="#FFFFFF00", fixedsize=true, width=4.7, height=0.1, label=""];
  APK [shape=note, style=filled, fillcolor="#FFF3E0", color="#E65100", fixedsize=true, width=2.9, height=0.75, label="servicio-electrico-freddy.apk\nKotlin · MVVM"];
