  p1 [shape=box, style=filled, fillcolor="#FFFFFF00", color="#FFFFFF00", fixedsize=true, width=0.02, height=0.02, label="", group="g_auth"];
  { rank=same; A_CLI -> p2 -> p8 -> p4 -> p3 -> p1 [style=invis]; }
