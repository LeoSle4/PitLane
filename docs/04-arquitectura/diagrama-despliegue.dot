  T_FS [shape=box, style=filled, fillcolor="#FFFFFF00", color="#FFFFFF00", fixedsize=true, width=0.02, height=0.02, label="", group="g_fs"];
  T_AUTH [shape=box, style=filled, fillcolor="#FFFFFF00", color="#FFFFFF00", fixedsize=true, width=0.02, height=0.02, label="", group="g_auth"];
