<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0"
                  xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0"
                  id="Definitions_Reparacion"
                  targetNamespace="http://bpmn.io/schema/bpmn"
                  exporter="Camunda Modeler"
                  exporterVersion="5.0.0">

  <bpmn:collaboration id="Collaboration_Reparacion">
    <bpmn:participant id="Participant_Reparacion" name="Reparación del vehículo" processRef="Process_Reparacion" />
  </bpmn:collaboration>

  <bpmn:process id="Process_Reparacion" name="Reparación del vehículo" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Reparacion">
      <bpmn:lane id="Lane_Cliente" name="Cliente">
        <bpmn:flowNodeRef>Task_LlamarTaller</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RecibirAviso</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RecogerVehiculo</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Jefe" name="Jefe de Taller">
        <bpmn:flowNodeRef>Task_ConsultarTecnico</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InformarAvanceCliente</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_AvanceInformado</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_MergeLlamada</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_LlamarCliente</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_ClienteContesta</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Timer_VolverLlamar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EntregarVehiculo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_VehiculoEntregado</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Tecnico" name="Técnico Electricista">
        <bpmn:flowNodeRef>Start_TrabajoAutorizado</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RevisarFicha</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_MergeReparacion</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Reparar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Bnd_Consulta</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RegistrarHallazgos</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Probar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Funciona</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InformarAvanceJefe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InformarListo</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- ===== Flujo principal: reparación ===== -->
    <bpmn:startEvent id="Start_TrabajoAutorizado" name="Trabajo autorizado">
      <bpmn:outgoing>F_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:manualTask id="Task_RevisarFicha" name="Revisar ficha de ingreso del vehículo">
      <bpmn:incoming>F_1</bpmn:incoming>
      <bpmn:outgoing>F_2</bpmn:outgoing>
      <bpmn:property id="Prop_RevisarFicha" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DIA_Ficha">
        <bpmn:sourceRef>DOR_FichaEntrada</bpmn:sourceRef>
        <bpmn:targetRef>Prop_RevisarFicha</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="GW_MergeReparacion">
      <bpmn:incoming>F_2</bpmn:incoming>
      <bpmn:incoming>F_No1</bpmn:incoming>
      <bpmn:outgoing>F_3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:manualTask id="Task_Reparar" name="Reparar falla eléctrica">
      <bpmn:incoming>F_3</bpmn:incoming>
      <bpmn:outgoing>F_4</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="Task_RegistrarHallazgos" name="Registrar hallazgos y trabajos realizados">
      <bpmn:incoming>F_4</bpmn:incoming>
      <bpmn:outgoing>F_5</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DOA_Ficha">
        <bpmn:targetRef>DOR_FichaSalida</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:manualTask>
    <bpmn:manualTask id="Task_Probar" name="Probar funcionamiento del vehículo">
      <bpmn:incoming>F_5</bpmn:incoming>
      <bpmn:outgoing>F_6</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="GW_Funciona" name="¿Vehículo funciona correctamente?">
      <bpmn:incoming>F_6</bpmn:incoming>
      <bpmn:outgoing>F_Si1</bpmn:outgoing>
      <bpmn:outgoing>F_No1</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:manualTask id="Task_InformarListo" name="Informar al Jefe que el vehículo está listo">
      <bpmn:incoming>F_Si1</bpmn:incoming>
      <bpmn:outgoing>F_7</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="GW_MergeLlamada">
      <bpmn:incoming>F_7</bpmn:incoming>
      <bpmn:incoming>F_T</bpmn:incoming>
      <bpmn:outgoing>F_8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:manualTask id="Task_LlamarCliente" name="Llamar al cliente para avisar que está listo">
      <bpmn:incoming>F_8</bpmn:incoming>
      <bpmn:outgoing>F_9</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="GW_ClienteContesta" name="¿Cliente contesta?">
      <bpmn:incoming>F_9</bpmn:incoming>
      <bpmn:outgoing>F_Si2</bpmn:outgoing>
      <bpmn:outgoing>F_No2</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateCatchEvent id="Timer_VolverLlamar" name="Esperar para volver a llamar">
      <bpmn:incoming>F_No2</bpmn:incoming>
      <bpmn:outgoing>F_T</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TED_VolverLlamar" />
    </bpmn:intermediateCatchEvent>
    <bpmn:manualTask id="Task_RecibirAviso" name="Recibir aviso de vehículo listo">
      <bpmn:incoming>F_Si2</bpmn:incoming>
      <bpmn:outgoing>F_10</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="Task_RecogerVehiculo" name="Ir al taller a recoger el vehículo">
      <bpmn:incoming>F_10</bpmn:incoming>
      <bpmn:outgoing>F_11</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="Task_EntregarVehiculo" name="Entregar el vehículo al cliente">
      <bpmn:incoming>F_11</bpmn:incoming>
      <bpmn:outgoing>F_12</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:endEvent id="End_VehiculoEntregado" name="Vehículo entregado al cliente">
      <bpmn:incoming>F_12</bpmn:incoming>
    </bpmn:endEvent>

    <!-- ===== Consulta del cliente durante la reparación (puede ocurrir varias veces) ===== -->
    <bpmn:boundaryEvent id="Bnd_Consulta" name="Cliente quiere conocer el avance" cancelActivity="false" attachedToRef="Task_Reparar">
      <bpmn:outgoing>F_B1</bpmn:outgoing>
      <bpmn:conditionalEventDefinition id="CED_Consulta">
        <bpmn:condition xsi:type="bpmn:tFormalExpression">Cliente quiere conocer el avance</bpmn:condition>
      </bpmn:conditionalEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:manualTask id="Task_LlamarTaller" name="Llamar al taller para consultar el avance">
      <bpmn:incoming>F_B1</bpmn:incoming>
      <bpmn:outgoing>F_B2</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="Task_ConsultarTecnico" name="Consultar avance al técnico">
      <bpmn:incoming>F_B2</bpmn:incoming>
      <bpmn:outgoing>F_B3</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="Task_InformarAvanceJefe" name="Informar avance al Jefe de Taller">
      <bpmn:incoming>F_B3</bpmn:incoming>
      <bpmn:outgoing>F_B4</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="Task_InformarAvanceCliente" name="Informar avance al cliente">
      <bpmn:incoming>F_B4</bpmn:incoming>
      <bpmn:outgoing>F_B5</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:endEvent id="End_AvanceInformado" name="Avance informado al cliente">
      <bpmn:incoming>F_B5</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:dataObject id="DO_Ficha" />
    <bpmn:dataObjectReference id="DOR_FichaEntrada" name="Ficha de ingreso (papel)" dataObjectRef="DO_Ficha" />
    <bpmn:dataObjectReference id="DOR_FichaSalida" name="Ficha de ingreso (papel)" dataObjectRef="DO_Ficha" />

    <!-- ===== Anotaciones ===== -->
    <bpmn:textAnnotation id="Ann_Leyenda">
      <bpmn:text>Leyenda: actividades en verde = se automatizarán con la app (vista del cliente y vista del taller)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Ann_Ficha">
      <bpmn:text>Ficha en papel: puede estar incompleta o ilegible</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_Ficha" sourceRef="Task_RevisarFicha" targetRef="Ann_Ficha" />
    <bpmn:textAnnotation id="Ann_LlamarTaller">
      <bpmn:text>El cliente no sabe el estado de su vehículo y llama varias veces</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_LlamarTaller" sourceRef="Task_LlamarTaller" targetRef="Ann_LlamarTaller" />
    <bpmn:textAnnotation id="Ann_Interrupcion">
      <bpmn:text>Cuello de botella: el técnico interrumpe la reparación para informar</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_Interrupcion" sourceRef="Task_InformarAvanceJefe" targetRef="Ann_Interrupcion" />
    <bpmn:textAnnotation id="Ann_Hallazgos">
      <bpmn:text>Hallazgos en papel y sin fotos: el cliente no los ve</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_Hallazgos" sourceRef="Task_RegistrarHallazgos" targetRef="Ann_Hallazgos" />
    <bpmn:textAnnotation id="Ann_LlamarCliente">
      <bpmn:text>Llamadas sin respuesta: el vehículo listo ocupa espacio</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_LlamarCliente" sourceRef="Task_LlamarCliente" targetRef="Ann_LlamarCliente" />

    <!-- ===== Flujos ===== -->
    <bpmn:sequenceFlow id="F_1" sourceRef="Start_TrabajoAutorizado" targetRef="Task_RevisarFicha" />
    <bpmn:sequenceFlow id="F_2" sourceRef="Task_RevisarFicha" targetRef="GW_MergeReparacion" />
    <bpmn:sequenceFlow id="F_3" sourceRef="GW_MergeReparacion" targetRef="Task_Reparar" />
    <bpmn:sequenceFlow id="F_4" sourceRef="Task_Reparar" targetRef="Task_RegistrarHallazgos" />
    <bpmn:sequenceFlow id="F_5" sourceRef="Task_RegistrarHallazgos" targetRef="Task_Probar" />
    <bpmn:sequenceFlow id="F_6" sourceRef="Task_Probar" targetRef="GW_Funciona" />
    <bpmn:sequenceFlow id="F_Si1" name="Sí" sourceRef="GW_Funciona" targetRef="Task_InformarListo" />
    <bpmn:sequenceFlow id="F_No1" name="No" sourceRef="GW_Funciona" targetRef="GW_MergeReparacion" />
    <bpmn:sequenceFlow id="F_7" sourceRef="Task_InformarListo" targetRef="GW_MergeLlamada" />
    <bpmn:sequenceFlow id="F_8" sourceRef="GW_MergeLlamada" targetRef="Task_LlamarCliente" />
    <bpmn:sequenceFlow id="F_9" sourceRef="Task_LlamarCliente" targetRef="GW_ClienteContesta" />
    <bpmn:sequenceFlow id="F_Si2" name="Sí" sourceRef="GW_ClienteContesta" targetRef="Task_RecibirAviso" />
    <bpmn:sequenceFlow id="F_No2" name="No" sourceRef="GW_ClienteContesta" targetRef="Timer_VolverLlamar" />
    <bpmn:sequenceFlow id="F_T" sourceRef="Timer_VolverLlamar" targetRef="GW_MergeLlamada" />
    <bpmn:sequenceFlow id="F_10" sourceRef="Task_RecibirAviso" targetRef="Task_RecogerVehiculo" />
    <bpmn:sequenceFlow id="F_11" sourceRef="Task_RecogerVehiculo" targetRef="Task_EntregarVehiculo" />
    <bpmn:sequenceFlow id="F_12" sourceRef="Task_EntregarVehiculo" targetRef="End_VehiculoEntregado" />
    <bpmn:sequenceFlow id="F_B1" sourceRef="Bnd_Consulta" targetRef="Task_LlamarTaller" />
    <bpmn:sequenceFlow id="F_B2" sourceRef="Task_LlamarTaller" targetRef="Task_ConsultarTecnico" />
    <bpmn:sequenceFlow id="F_B3" sourceRef="Task_ConsultarTecnico" targetRef="Task_InformarAvanceJefe" />
    <bpmn:sequenceFlow id="F_B4" sourceRef="Task_InformarAvanceJefe" targetRef="Task_InformarAvanceCliente" />
    <bpmn:sequenceFlow id="F_B5" sourceRef="Task_InformarAvanceCliente" targetRef="End_AvanceInformado" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_Reparacion">
    <bpmndi:BPMNPlane id="BPMNPlane_Reparacion" bpmnElement="Collaboration_Reparacion">

      <bpmndi:BPMNShape id="S_Participant" bpmnElement="Participant_Reparacion" isHorizontal="true">
        <dc:Bounds x="160" y="40" width="1830" height="790" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Lane_Cliente" bpmnElement="Lane_Cliente" isHorizontal="true">
        <dc:Bounds x="190" y="40" width="1800" height="200" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Lane_Jefe" bpmnElement="Lane_Jefe" isHorizontal="true">
        <dc:Bounds x="190" y="240" width="1800" height="220" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Lane_Tecnico" bpmnElement="Lane_Tecnico" isHorizontal="true">
        <dc:Bounds x="190" y="460" width="1800" height="370" />
      </bpmndi:BPMNShape>

      <!-- Cliente -->
      <bpmndi:BPMNShape id="S_Task_LlamarTaller" bpmnElement="Task_LlamarTaller" bioc:stroke="#205022" bioc:fill="#c8e6c9" color:background-color="#c8e6c9" color:border-color="#205022">
        <dc:Bounds x="530" y="100" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Task_RecibirAviso" bpmnElement="Task_RecibirAviso" bioc:stroke="#205022" bioc:fill="#c8e6c9" color:background-color="#c8e6c9" color:border-color="#205022">
        <dc:Bounds x="1520" y="100" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Task_RecogerVehiculo" bpmnElement="Task_RecogerVehiculo">
        <dc:Bounds x="1700" y="100" width="120" height="80" />
      </bpmndi:BPMNShape>

      <!-- Jefe de Taller -->
      <bpmndi:BPMNShape id="S_Task_ConsultarTecnico" bpmnElement="Task_ConsultarTecnico">
        <dc:Bounds x="700" y="330" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Task_InformarAvanceCliente" bpmnElement="Task_InformarAvanceCliente">
        <dc:Bounds x="1000" y="330" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_End_AvanceInformado" bpmnElement="End_AvanceInformado">
        <dc:Bounds x="1042" y="252" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="950" y="257" width="85" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_GW_MergeLlamada" bpmnElement="GW_MergeLlamada" isMarkerVisible="true">
        <dc:Bounds x="1195" y="345" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Task_LlamarCliente" bpmnElement="Task_LlamarCliente" bioc:stroke="#205022" bioc:fill="#c8e6c9" color:background-color="#c8e6c9" color:border-color="#205022">
        <dc:Bounds x="1280" y="330" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_GW_ClienteContesta" bpmnElement="GW_ClienteContesta" isMarkerVisible="true">
        <dc:Bounds x="1435" y="345" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="1470" y="400" width="60" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Task_EntregarVehiculo" bpmnElement="Task_EntregarVehiculo" bioc:stroke="#205022" bioc:fill="#c8e6c9" color:background-color="#c8e6c9" color:border-color="#205022">
        <dc:Bounds x="1700" y="330" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_End_VehiculoEntregado" bpmnElement="End_VehiculoEntregado">
        <dc:Bounds x="1880" y="352" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="1853" y="395" width="90" height="40" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Timer_VolverLlamar" bpmnElement="Timer_VolverLlamar">
        <dc:Bounds x="1322" y="252" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="1295" y="292" width="90" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- Técnico Electricista -->
      <bpmndi:BPMNShape id="S_Start_TrabajoAutorizado" bpmnElement="Start_TrabajoAutorizado">
        <dc:Bounds x="232" y="622" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="215" y="665" width="70" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Task_RevisarFicha" bpmnElement="Task_RevisarFicha" bioc:stroke="#205022" bioc:fill="#c8e6c9" color:background-color="#c8e6c9" color:border-color="#205022">
        <dc:Bounds x="300" y="600" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_GW_MergeReparacion" bpmnElement="GW_MergeReparacion" isMarkerVisible="true">
        <dc:Bounds x="450" y="615" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Task_Reparar" bpmnElement="Task_Reparar">
        <dc:Bounds x="530" y="600" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Bnd_Consulta" bpmnElement="Bnd_Consulta">
        <dc:Bounds x="572" y="582" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="470" y="560" width="95" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Task_RegistrarHallazgos" bpmnElement="Task_RegistrarHallazgos" bioc:stroke="#205022" bioc:fill="#c8e6c9" color:background-color="#c8e6c9" color:border-color="#205022">
        <dc:Bounds x="690" y="600" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Task_Probar" bpmnElement="Task_Probar">
        <dc:Bounds x="860" y="600" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_GW_Funciona" bpmnElement="GW_Funciona" isMarkerVisible="true">
        <dc:Bounds x="1010" y="615" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="1045" y="670" width="90" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Task_InformarListo" bpmnElement="Task_InformarListo" bioc:stroke="#205022" bioc:fill="#c8e6c9" color:background-color="#c8e6c9" color:border-color="#205022">
        <dc:Bounds x="1160" y="600" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Task_InformarAvanceJefe" bpmnElement="Task_InformarAvanceJefe">
        <dc:Bounds x="860" y="480" width="120" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="S_DOR_FichaEntrada" bpmnElement="DOR_FichaEntrada">
        <dc:Bounds x="342" y="705" width="36" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="255" y="717" width="80" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_DOR_FichaSalida" bpmnElement="DOR_FichaSalida">
        <dc:Bounds x="737" y="705" width="36" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="650" y="717" width="80" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- Anotaciones -->
      <bpmndi:BPMNShape id="S_Ann_Leyenda" bpmnElement="Ann_Leyenda">
        <dc:Bounds x="1300" y="760" width="420" height="35" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Ann_Ficha" bpmnElement="Ann_Ficha">
        <dc:Bounds x="280" y="480" width="170" height="40" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Ann_LlamarTaller" bpmnElement="Ann_LlamarTaller">
