<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0"
                  xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0"
                  id="Definitions_Recepcion"
                  targetNamespace="http://bpmn.io/schema/bpmn"
                  exporter="Camunda Modeler"
                  exporterVersion="5.0.0">

  <bpmn:collaboration id="Collaboration_Recepcion">
    <bpmn:participant id="Participant_Recepcion" name="Recepción del vehículo" processRef="Process_Recepcion" />
  </bpmn:collaboration>

  <bpmn:process id="Process_Recepcion" name="Recepción del vehículo" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Recepcion">
      <bpmn:lane id="Lane_Cliente" name="Cliente">
        <bpmn:flowNodeRef>Start_Falla</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_LlevarVehiculo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_JefeDisponible</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Cond_EsperaJefe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_MergeAtencion</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ProporcionarDatos</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DescribirFalla</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RecibirIndicaciones</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_VehiculoIngresado</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Jefe" name="Jefe de Taller">
        <bpmn:flowNodeRef>Task_BuscarHistorial</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_ClienteRegistrado</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RegistrarCliente</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_MergeRegistro</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_LlenarFicha</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RevisarEstado</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DejarFicha</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_IndicarCliente</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- ===== Cliente ===== -->
    <bpmn:startEvent id="Start_Falla" name="Vehículo presenta falla eléctrica">
      <bpmn:outgoing>F_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:manualTask id="Task_LlevarVehiculo" name="Llevar vehículo al taller">
      <bpmn:incoming>F_1</bpmn:incoming>
      <bpmn:outgoing>F_2</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="GW_JefeDisponible" name="¿Jefe de Taller disponible?">
      <bpmn:incoming>F_2</bpmn:incoming>
      <bpmn:outgoing>F_Si1</bpmn:outgoing>
      <bpmn:outgoing>F_No1</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateCatchEvent id="Cond_EsperaJefe" name="Jefe de Taller se desocupa">
      <bpmn:incoming>F_No1</bpmn:incoming>
      <bpmn:outgoing>F_T</bpmn:outgoing>
      <bpmn:conditionalEventDefinition id="CED_EsperaJefe">
        <bpmn:condition xsi:type="bpmn:tFormalExpression">Jefe de Taller disponible</bpmn:condition>
      </bpmn:conditionalEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="GW_MergeAtencion">
      <bpmn:incoming>F_Si1</bpmn:incoming>
      <bpmn:incoming>F_T</bpmn:incoming>
      <bpmn:outgoing>F_3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:manualTask id="Task_ProporcionarDatos" name="Proporcionar datos personales y del vehículo">
      <bpmn:incoming>F_3</bpmn:incoming>
      <bpmn:outgoing>F_4</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="Task_DescribirFalla" name="Describir falla del vehículo">
      <bpmn:incoming>F_4</bpmn:incoming>
      <bpmn:outgoing>F_5</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="Task_RecibirIndicaciones" name="Recibir indicaciones del Jefe de Taller">
      <bpmn:incoming>F_13</bpmn:incoming>
      <bpmn:outgoing>F_14</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:endEvent id="End_VehiculoIngresado" name="Vehículo ingresado">
      <bpmn:incoming>F_14</bpmn:incoming>
    </bpmn:endEvent>

    <!-- ===== Jefe de Taller ===== -->
    <bpmn:manualTask id="Task_BuscarHistorial" name="Buscar historial del cliente en cuaderno">
      <bpmn:incoming>F_5</bpmn:incoming>
      <bpmn:outgoing>F_6</bpmn:outgoing>
      <bpmn:property id="Prop_BuscarHistorial" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DIA_Cuaderno">
        <bpmn:sourceRef>DOR_Cuaderno</bpmn:sourceRef>
        <bpmn:targetRef>Prop_BuscarHistorial</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="GW_ClienteRegistrado" name="¿Cliente registrado?">
      <bpmn:incoming>F_6</bpmn:incoming>
      <bpmn:outgoing>F_Si2</bpmn:outgoing>
      <bpmn:outgoing>F_No2</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:manualTask id="Task_RegistrarCliente" name="Anotar datos del cliente y vehículo en cuaderno">
      <bpmn:incoming>F_No2</bpmn:incoming>
      <bpmn:outgoing>F_7</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DOA_Cuaderno">
        <bpmn:targetRef>DOR_Cuaderno</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="GW_MergeRegistro">
      <bpmn:incoming>F_Si2</bpmn:incoming>
      <bpmn:incoming>F_7</bpmn:incoming>
      <bpmn:outgoing>F_8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:manualTask id="Task_LlenarFicha" name="Llenar ficha de ingreso">
      <bpmn:incoming>F_9</bpmn:incoming>
      <bpmn:outgoing>F_10</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DOA_Ficha1">
        <bpmn:targetRef>DOR_Ficha</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:manualTask>
    <bpmn:manualTask id="Task_RevisarEstado" name="Revisar estado exterior del vehículo">
      <bpmn:incoming>F_8</bpmn:incoming>
      <bpmn:outgoing>F_9</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="Task_DejarFicha" name="Dejar ficha en el vehículo">
      <bpmn:incoming>F_10</bpmn:incoming>
      <bpmn:outgoing>F_11</bpmn:outgoing>
      <bpmn:property id="Prop_DejarFicha" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DIA_Ficha">
        <bpmn:sourceRef>DOR_Ficha</bpmn:sourceRef>
        <bpmn:targetRef>Prop_DejarFicha</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:manualTask>
    <bpmn:manualTask id="Task_IndicarCliente" name="Indicar al cliente que se le llamará con novedades">
      <bpmn:incoming>F_11</bpmn:incoming>
      <bpmn:outgoing>F_13</bpmn:outgoing>
    </bpmn:manualTask>

    <bpmn:dataObjectReference id="DOR_Cuaderno" name="Cuaderno de registros" dataObjectRef="DO_Cuaderno" />
    <bpmn:dataObject id="DO_Cuaderno" />
    <bpmn:dataObjectReference id="DOR_Ficha" name="Ficha de ingreso (papel)" dataObjectRef="DO_Ficha" />
    <bpmn:dataObject id="DO_Ficha" />

    <!-- ===== Anotaciones ===== -->
    <bpmn:textAnnotation id="Ann_Leyenda">
      <bpmn:text>Leyenda: actividades en verde = se automatizarán con la app (vista del cliente y vista del taller)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Ann_Jefe">
      <bpmn:text>Cuello de botella: solo el Jefe recibe vehículos; el cliente espera sin saber cuánto</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_Jefe" sourceRef="GW_JefeDisponible" targetRef="Ann_Jefe" />
    <bpmn:textAnnotation id="Ann_Datos">
      <bpmn:text>El cliente repite sus datos en cada visita</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_Datos" sourceRef="Task_ProporcionarDatos" targetRef="Ann_Datos" />
    <bpmn:textAnnotation id="Ann_Falla">
      <bpmn:text>La falla se explica de palabra y puede anotarse incompleta</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_Falla" sourceRef="Task_DescribirFalla" targetRef="Ann_Falla" />
    <bpmn:textAnnotation id="Ann_Historial">
      <bpmn:text>Búsqueda manual: demora y datos ilegibles o perdidos</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_Historial" sourceRef="Task_BuscarHistorial" targetRef="Ann_Historial" />
    <bpmn:textAnnotation id="Ann_Estado">
      <bpmn:text>Ficha en papel y sin fotos: no queda evidencia del estado del vehículo</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_Estado" sourceRef="Task_LlenarFicha" targetRef="Ann_Estado" />
    <bpmn:textAnnotation id="Ann_Indicar">
      <bpmn:text>El cliente se va sin comprobante y sin forma de consultar el avance</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_Indicar" sourceRef="Task_RecibirIndicaciones" targetRef="Ann_Indicar" />

    <!-- ===== Flujos ===== -->
    <bpmn:sequenceFlow id="F_1" sourceRef="Start_Falla" targetRef="Task_LlevarVehiculo" />
    <bpmn:sequenceFlow id="F_2" sourceRef="Task_LlevarVehiculo" targetRef="GW_JefeDisponible" />
    <bpmn:sequenceFlow id="F_Si1" name="Sí" sourceRef="GW_JefeDisponible" targetRef="GW_MergeAtencion" />
    <bpmn:sequenceFlow id="F_No1" name="No" sourceRef="GW_JefeDisponible" targetRef="Cond_EsperaJefe" />
    <bpmn:sequenceFlow id="F_T" sourceRef="Cond_EsperaJefe" targetRef="GW_MergeAtencion" />
    <bpmn:sequenceFlow id="F_3" sourceRef="GW_MergeAtencion" targetRef="Task_ProporcionarDatos" />
    <bpmn:sequenceFlow id="F_4" sourceRef="Task_ProporcionarDatos" targetRef="Task_DescribirFalla" />
    <bpmn:sequenceFlow id="F_5" sourceRef="Task_DescribirFalla" targetRef="Task_BuscarHistorial" />
    <bpmn:sequenceFlow id="F_6" sourceRef="Task_BuscarHistorial" targetRef="GW_ClienteRegistrado" />
    <bpmn:sequenceFlow id="F_Si2" name="Sí" sourceRef="GW_ClienteRegistrado" targetRef="GW_MergeRegistro" />
    <bpmn:sequenceFlow id="F_No2" name="No" sourceRef="GW_ClienteRegistrado" targetRef="Task_RegistrarCliente" />
    <bpmn:sequenceFlow id="F_7" sourceRef="Task_RegistrarCliente" targetRef="GW_MergeRegistro" />
    <bpmn:sequenceFlow id="F_8" sourceRef="GW_MergeRegistro" targetRef="Task_RevisarEstado" />
    <bpmn:sequenceFlow id="F_9" sourceRef="Task_RevisarEstado" targetRef="Task_LlenarFicha" />
    <bpmn:sequenceFlow id="F_10" sourceRef="Task_LlenarFicha" targetRef="Task_DejarFicha" />
    <bpmn:sequenceFlow id="F_11" sourceRef="Task_DejarFicha" targetRef="Task_IndicarCliente" />
    <bpmn:sequenceFlow id="F_13" sourceRef="Task_IndicarCliente" targetRef="Task_RecibirIndicaciones" />
    <bpmn:sequenceFlow id="F_14" sourceRef="Task_RecibirIndicaciones" targetRef="End_VehiculoIngresado" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_Recepcion">
    <bpmndi:BPMNPlane id="BPMNPlane_Recepcion" bpmnElement="Collaboration_Recepcion">

      <bpmndi:BPMNShape id="S_Participant" bpmnElement="Participant_Recepcion" isHorizontal="true">
        <dc:Bounds x="160" y="40" width="1960" height="540" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Lane_Cliente" bpmnElement="Lane_Cliente" isHorizontal="true">
        <dc:Bounds x="190" y="40" width="1930" height="230" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Lane_Jefe" bpmnElement="Lane_Jefe" isHorizontal="true">
        <dc:Bounds x="190" y="270" width="1930" height="310" />
      </bpmndi:BPMNShape>

      <!-- Cliente -->
      <bpmndi:BPMNShape id="S_Start_Falla" bpmnElement="Start_Falla">
        <dc:Bounds x="232" y="152" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="205" y="195" width="90" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Task_LlevarVehiculo" bpmnElement="Task_LlevarVehiculo">
        <dc:Bounds x="300" y="130" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_GW_JefeDisponible" bpmnElement="GW_JefeDisponible" isMarkerVisible="true">
        <dc:Bounds x="470" y="145" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="505" y="200" width="80" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Cond_EsperaJefe" bpmnElement="Cond_EsperaJefe">
        <dc:Bounds x="567" y="72" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="540" y="113" width="90" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_GW_MergeAtencion" bpmnElement="GW_MergeAtencion" isMarkerVisible="true">
        <dc:Bounds x="650" y="145" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Task_ProporcionarDatos" bpmnElement="Task_ProporcionarDatos" bioc:stroke="#205022" bioc:fill="#c8e6c9" color:background-color="#c8e6c9" color:border-color="#205022">
        <dc:Bounds x="730" y="130" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Task_DescribirFalla" bpmnElement="Task_DescribirFalla" bioc:stroke="#205022" bioc:fill="#c8e6c9" color:background-color="#c8e6c9" color:border-color="#205022">
        <dc:Bounds x="890" y="130" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Task_RecibirIndicaciones" bpmnElement="Task_RecibirIndicaciones" bioc:stroke="#205022" bioc:fill="#c8e6c9" color:background-color="#c8e6c9" color:border-color="#205022">
        <dc:Bounds x="1860" y="130" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_End_VehiculoIngresado" bpmnElement="End_VehiculoIngresado">
        <dc:Bounds x="2040" y="152" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="2028" y="195" width="60" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- Jefe de Taller -->
      <bpmndi:BPMNShape id="S_Task_BuscarHistorial" bpmnElement="Task_BuscarHistorial" bioc:stroke="#205022" bioc:fill="#c8e6c9" color:background-color="#c8e6c9" color:border-color="#205022">
        <dc:Bounds x="890" y="340" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_GW_ClienteRegistrado" bpmnElement="GW_ClienteRegistrado" isMarkerVisible="true">
        <dc:Bounds x="1060" y="355" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="1102" y="406" width="56" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Task_RegistrarCliente" bpmnElement="Task_RegistrarCliente" bioc:stroke="#205022" bioc:fill="#c8e6c9" color:background-color="#c8e6c9" color:border-color="#205022">
        <dc:Bounds x="1140" y="450" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_GW_MergeRegistro" bpmnElement="GW_MergeRegistro" isMarkerVisible="true">
        <dc:Bounds x="1300" y="355" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Task_LlenarFicha" bpmnElement="Task_LlenarFicha" bioc:stroke="#205022" bioc:fill="#c8e6c9" color:background-color="#c8e6c9" color:border-color="#205022">
        <dc:Bounds x="1540" y="340" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Task_RevisarEstado" bpmnElement="Task_RevisarEstado">
        <dc:Bounds x="1380" y="340" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Task_DejarFicha" bpmnElement="Task_DejarFicha">
        <dc:Bounds x="1700" y="340" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Task_IndicarCliente" bpmnElement="Task_IndicarCliente" bioc:stroke="#205022" bioc:fill="#c8e6c9" color:background-color="#c8e6c9" color:border-color="#205022">
        <dc:Bounds x="1860" y="340" width="130" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="S_DOR_Cuaderno" bpmnElement="DOR_Cuaderno">
        <dc:Bounds x="932" y="470" width="36" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="915" y="525" width="70" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_DOR_Ficha" bpmnElement="DOR_Ficha">
        <dc:Bounds x="1662" y="470" width="36" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="1640" y="525" width="80" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- Anotaciones -->
      <bpmndi:BPMNShape id="S_Ann_Leyenda" bpmnElement="Ann_Leyenda">
        <dc:Bounds x="220" y="525" width="420" height="35" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Ann_Jefe" bpmnElement="Ann_Jefe">
        <dc:Bounds x="380" y="290" width="260" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Ann_Datos" bpmnElement="Ann_Datos">
        <dc:Bounds x="720" y="55" width="150" height="40" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Ann_Falla" bpmnElement="Ann_Falla">
        <dc:Bounds x="900" y="55" width="200" height="40" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Ann_Historial" bpmnElement="Ann_Historial">
        <dc:Bounds x="970" y="285" width="210" height="45" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Ann_Estado" bpmnElement="Ann_Estado">
        <dc:Bounds x="1500" y="285" width="220" height="45" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Ann_Indicar" bpmnElement="Ann_Indicar">
        <dc:Bounds x="1800" y="55" width="260" height="45" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="E_Assoc_Jefe" bpmnElement="Assoc_Jefe"><di:waypoint x="495" y="195" /><di:waypoint x="495" y="290" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_Assoc_Datos" bpmnElement="Assoc_Datos"><di:waypoint x="795" y="130" /><di:waypoint x="795" y="95" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_Assoc_Falla" bpmnElement="Assoc_Falla"><di:waypoint x="950" y="130" /><di:waypoint x="950" y="95" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_Assoc_Historial" bpmnElement="Assoc_Historial"><di:waypoint x="980" y="340" /><di:waypoint x="980" y="330" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_Assoc_Estado" bpmnElement="Assoc_Estado"><di:waypoint x="1600" y="340" /><di:waypoint x="1600" y="330" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_Assoc_Indicar" bpmnElement="Assoc_Indicar"><di:waypoint x="1925" y="130" /><di:waypoint x="1925" y="100" /></bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="E_DIA_Cuaderno" bpmnElement="DIA_Cuaderno"><di:waypoint x="950" y="470" /><di:waypoint x="950" y="420" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_DOA_Cuaderno" bpmnElement="DOA_Cuaderno"><di:waypoint x="1205" y="530" /><di:waypoint x="1205" y="555" /><di:waypoint x="1030" y="555" /><di:waypoint x="1030" y="495" /><di:waypoint x="968" y="495" /></bpmndi:BPMNEdge>
